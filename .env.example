# ============================================================
# 大模型服务配置（可选）。不配置时，工具自动使用本地离线兜底引擎，
# 仍可完整跑通“输入—生成—校验—人工干预—导出—留痕”全流程。
# 复制本文件为 .env 后填入真实值；.env 已在 .gitignore 中排除。
# ============================================================

# 是否启用在线大模型：true / false（留空或 false 则走本地引擎）
LLM_ENABLED=false

# OpenAI 兼容接口地址（豆包 / 通义千问 / 商汤等均可对接）
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 模型接入点 / 模型名
LLM_MODEL=doubao-pro-32k

# API Key（仅通过环境变量注入，禁止硬编码进前端或公开仓库）
LLM_API_KEY=

# 请求超时（秒）
LLM_TIMEOUT=20
